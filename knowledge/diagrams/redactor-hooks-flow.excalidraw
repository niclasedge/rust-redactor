    {"type":"text","id":"ev4_t","x":1848,"y":974,"width":480,"height":275,"text":"# audit log: <log-dir>/YYYY-MM-DD-redacted.log\n# TSV; one line per rule hit\n\ntimestamp\\tsource=…\\tcommand=…\\tmode=…\\trule=…\\tcount=…\\tsample=…\n\n# example lines:\n2026-04-28T20:50…+02:00  source=stdin\n  command=Read test.csv     mode=pattern\n  rule=github_token         count=1\n  sample=ghp_abc...\n\n2026-04-28T20:50…+02:00  source=wrap:bash\n  command=bash -c deploy.sh mode=wrap\n  rule=openai_key           count=1\n  sample=sk-proj-FAK...\n\n2026-04-28T20:50…+02:00  source=session-start\n  command=/Users/.../rust-redactor\n  mode=session  rule=session_start\n  count=1  sample=","originalText":"# audit log: <log-dir>/YYYY-MM-DD-redacted.log\n# TSV; one line per rule hit\n\ntimestamp\\tsource=…\\tcommand=…\\tmode=…\\trule=…\\tcount=…\\tsample=…\n\n# example lines:\n2026-04-28T20:50…+02:00  source=stdin\n  command=Read test.csv     mode=pattern\n  rule=github_token         count=1\n  sample=ghp_abc...\n\n2026-04-28T20:50…+02:00  source=wrap:bash\n  command=bash -c deploy.sh mode=wrap\n  rule=openai_key           count=1\n  sample=sk-proj-FAK...\n\n2026-04-28T20:50…+02:00  source=session-start\n  command=/Users/.../rust-redactor\n  mode=session  rule=session_start\n  count=1  sample=","fontSize":11,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#22c55e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":700042,"version":1,"versionNonce":700043,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":"ev4","lineHeight":1.25},
