    {"type":"text","id":"out_allow_t","x":430,"y":770,"width":670,"height":100,"text":"ALLOW       stdout = {}\n\nClaude Code proceeds with the tool call / accepts the prompt.\nNo modification, no log entry from this hook.\n(post-tool may still emit a sanitization log of its own)","originalText":"ALLOW       stdout = {}\n\nClaude Code proceeds with the tool call / accepts the prompt.\nNo modification, no log entry from this hook.\n(post-tool may still emit a sanitization log of its own)","fontSize":13,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","strokeColor":"#064e3b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":600012,"version":1,"versionNonce":600013,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":"out_allow","lineHeight":1.25},

