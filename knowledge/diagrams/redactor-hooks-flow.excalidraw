    {"type":"text","id":"l4_s1_t","x":1510,"y":280,"width":320,"height":56,"text":"1. is_direct check\nif cmd starts with `redactor` and not\n`redactor wrap` → SKIP (already sanitized;\nre-running causes double-pass artifacts)","originalText":"1. is_direct check\nif cmd starts with `redactor` and not\n`redactor wrap` → SKIP (already sanitized;\nre-running causes double-pass artifacts)","fontSize":11,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","strokeColor":"#374151","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":500012,"version":1,"versionNonce":500013,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":"l4_s1","lineHeight":1.25},

