    {"type":"text","id":"l4_s3_t","x":1510,"y":470,"width":320,"height":90,"text":"3. sanitize tool_response.body\nredact_pattern / redact_json /\nredact_csv / redact_env\n\nif sanitized == raw → ALLOW\nelse → BLOCK with sanitized text\n(model never sees raw)","originalText":"3. sanitize tool_response.body\nredact_pattern / redact_json /\nredact_csv / redact_env\n\nif sanitized == raw → ALLOW\nelse → BLOCK with sanitized text\n(model never sees raw)","fontSize":11,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","strokeColor":"#374151","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":500032,"version":1,"versionNonce":500033,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":"l4_s3","lineHeight":1.25},

