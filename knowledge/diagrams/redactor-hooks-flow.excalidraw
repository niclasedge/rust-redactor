    {"type":"text","id":"ev2_t","x":668,"y":974,"width":540,"height":275,"text":"// patterns::defaults() — used by `prompt` and `post-tool`\n// rule_name              → replacement\n\nanthropic_key             → <redacted:anthropic_key>\nopenai_key                → <redacted:openai_key>\naws_access_key            → <redacted:aws_access_key>\ngithub_token              → <redacted:github_token>\nslack_token               → <redacted:slack_token>\nstripe_live               → <redacted:stripe_live>\njwt                       → <redacted:jwt>\nprivate_key (PEM block)   → <redacted:private_key>\niban_de                   → <redacted:iban>\nphone_de                  → <redacted:phone_de>\nbirthdate_de              → <redacted:birthdate>\nsvn_de                    → <redacted:svn>\nipv4                      → <redacted:ipv4>\nconn_string               → <redacted:conn_string>\nazure_cred_guid           → <redacted:azure_cred_guid>\ncert_thumbprint           → <redacted:cert_thumbprint>\nkeyword (user list)       → <redacted:keyword>","originalText":"// patterns::defaults() — used by `prompt` and `post-tool`\n// rule_name              → replacement\n\nanthropic_key             → <redacted:anthropic_key>\nopenai_key                → <redacted:openai_key>\naws_access_key            → <redacted:aws_access_key>\ngithub_token              → <redacted:github_token>\nslack_token               → <redacted:slack_token>\nstripe_live               → <redacted:stripe_live>\njwt                       → <redacted:jwt>\nprivate_key (PEM block)   → <redacted:private_key>\niban_de                   → <redacted:iban>\nphone_de                  → <redacted:phone_de>\nbirthdate_de              → <redacted:birthdate>\nsvn_de                    → <redacted:svn>\nipv4                      → <redacted:ipv4>\nconn_string               → <redacted:conn_string>\nazure_cred_guid           → <redacted:azure_cred_guid>\ncert_thumbprint           → <redacted:cert_thumbprint>\nkeyword (user list)       → <redacted:keyword>","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#22c55e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":700022,"version":1,"versionNonce":700023,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":"ev2","lineHeight":1.25},
