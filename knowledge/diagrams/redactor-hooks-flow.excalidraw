    {"type":"text","id":"l3_s2_t","x":1160,"y":380,"width":290,"height":140,"text":"2. read-strict — ALWAYS BLOCK\nRead is fully disabled.\n\nReason returned to model includes\nsuggested replacement based on ext:\n  .json → redactor --type json <f>\n  .csv  → redactor --type csv  <f>\n  .env  → redactor --type env  <f>\n  else  → redactor wrap -- cat <f>","originalText":"2. read-strict — ALWAYS BLOCK\nRead is fully disabled.\n\nReason returned to model includes\nsuggested replacement based on ext:\n  .json → redactor --type json <f>\n  .csv  → redactor --type csv  <f>\n  .env  → redactor --type env  <f>\n  else  → redactor wrap -- cat <f>","fontSize":11,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","strokeColor":"#7f1d1d","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":400022,"version":1,"versionNonce":400023,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":"l3_s2","lineHeight":1.25},

