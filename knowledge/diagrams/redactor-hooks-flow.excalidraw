    {"type":"text","id":"out_block_t","x":1160,"y":770,"width":670,"height":100,"text":"BLOCK       stdout = {\"decision\":\"block\",\"reason\":\"…\"}\n\nClaude Code refuses the tool call / rejects the prompt.\nThe `reason` field is shown to the model — for post-tool, it\ncontains the sanitized output (model never sees raw bytes).","originalText":"BLOCK       stdout = {\"decision\":\"block\",\"reason\":\"…\"}\n\nClaude Code refuses the tool call / rejects the prompt.\nThe `reason` field is shown to the model — for post-tool, it\ncontains the sanitized output (model never sees raw bytes).","fontSize":13,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","strokeColor":"#7f1d1d","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":600022,"version":1,"versionNonce":600023,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":"out_block","lineHeight":1.25},

