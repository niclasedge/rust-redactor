    {"type":"text","id":"l4_s2_t","x":1510,"y":370,"width":320,"height":65,"text":"2. detect mode (file extension)\n.json → Json   .csv/.tsv → Csv\n.env / .envrc → Env\nfallback → Pattern (logs, free text)","originalText":"2. detect mode (file extension)\n.json → Json   .csv/.tsv → Csv\n.env / .envrc → Env\nfallback → Pattern (logs, free text)","fontSize":12,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","strokeColor":"#374151","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":500022,"version":1,"versionNonce":500023,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":"l4_s2","lineHeight":1.25},

